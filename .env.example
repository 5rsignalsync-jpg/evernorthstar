# Copy to .env and fill in. Never commit .env.
DUCKDB_PATH=./data/crypto_trends.duckdb

# Binance — default base is binance.us (binance.com geo-blocks the US).
# If you're outside the US (or on a VPN), set BINANCE_BASE_URL=https://api.binance.com
# for a much larger universe (~500 vs ~150 USDT pairs).
BINANCE_BASE_URL=https://api.binance.us
BINANCE_API_KEY=
BINANCE_API_SECRET=

# FinancialModelingPrep — free signup at https://site.financialmodelingprep.com/developer/docs
# Unlocks Congress trade disclosures (Pelosi Tracker + Kongressional Conviction).
# Free tier: 250 API calls/day. Paid Starter ($14/mo) adds historical fundamentals.
FMP_API_KEY=

# Stripe — get from https://dashboard.stripe.com/test/apikeys (test mode is fine to start)
# Set via: cd ~/Desktop/crypto-trends && uv run python scripts/set_launch_keys.py
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Gmail SMTP — for verification + password-reset + receipts.
# Needs a Google App Password (https://myaccount.google.com/apppasswords);
# 2-Step Verification must be enabled on the account first.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Added in later phases:
# LUNARCRUSH_API_KEY=
# GLASSNODE_API_KEY=
