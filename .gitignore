# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Data — large + regeneratable.
# IMPORTANT: leading slash anchors to repo root. Without it, the bare
# `data/` pattern ALSO ignores `crypto_trends/data/` — the Python package
# containing schema.sql, store.py, ingest/, etc. That bug caused every
# GitHub Actions auto-deploy to ship an image missing the data package,
# crashing the app on import.
/data/
*.duckdb
*.duckdb.wal
*.parquet

# Env / secrets
.env
.env.local
.env.*.local

# Node / Next.js (web/ subdir later)
node_modules/
.next/
out/
.turbo/

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Claude Code session/agent state — machine-local, not for git
.claude/

# Launchd plists — local to your Mac
*.plist

.vercel
